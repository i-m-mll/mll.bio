{
  "name": "personal-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:diff": "ENABLE_DIFF=true next dev",
    "dev:edit": "ENABLE_EDIT=true next dev",
    "predev": "node scripts/build-themes.mjs && node scripts/gen-images.mjs && node scripts/generate-search-index.mjs && node scripts/generate-rss.mjs && node scripts/setup-dev-assets.mjs",
    "build": "npm run lint && next build",
    "prebuild": "node scripts/build-themes.mjs && node scripts/gen-images.mjs && node scripts/generate-search-index.mjs && node scripts/generate-rss.mjs && node scripts/maybe-render-diagrams.mjs && node scripts/setup-dev-assets.mjs",
    "start": "next start",
    "lint": "eslint .",
    "serve": "npm run build && npx serve out -p 3000",
    "serve-only": "npx serve out -p 3000",
    "dev-fonts": "node scripts/gen-font-variants.mjs",
    "gen-images": "node scripts/gen-images.mjs",
    "render-diagrams": "node scripts/render-diagrams.mjs",
    "render-diagrams:dark": "node scripts/render-diagrams.mjs --dark",
    "render-diagrams:all": "node scripts/render-diagrams.mjs --all",
    "rebuild": "gh workflow run deploy.yml --repo i-m-mll/mll.bio --ref main"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "diff": "^8.0.4",
    "framer-motion": "^12.23.26",
    "gray-matter": "^4.0.3",
    "hast-util-to-string": "^3.0.1",
    "hastscript": "^9.0.1",
    "katex": "^0.16.22",
    "lunr": "^2.3.9",
    "next": "^15.5.19",
    "next-themes": "^0.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rehype-callouts": "^2.1.1",
    "rehype-code-group": "^0.2.4",
    "rehype-highlight": "^7.0.0",
    "rehype-katex": "^7.0.1",
    "remark-directive": "^3.0.0",
    "remark-gfm": "^4.0.0",
    "remark-html": "^15.0.2",
    "remark-math": "^6.0.0",
    "remark-mdx": "^2.2.0",
    "remark-parse": "^10.0.2",
    "tailwind-merge": "^2.1.0",
    "typeface-et-book": "^0.0.2",
    "unified": "^11.0.4",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.10",
    "@tailwindcss/typography": "^0.5.10",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "brace-expansion": "^1.1.15",
    "eslint": "^8",
    "eslint-config-next": "^15.5.19",
    "postcss": "^8.5.15",
    "sharp": "^0.33.2",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "@eslint/eslintrc": {
      "ajv": "^6.15.0",
      "minimatch": "^3.1.5"
    },
    "@humanwhocodes/config-array": {
      "minimatch": "^3.1.5"
    },
    "@tailwindcss/oxide": {
      "tar": "^7.5.16"
    },
    "diff": "$diff",
    "eslint": {
      "ajv": "^6.15.0",
      "minimatch": "^3.1.5"
    },
    "eslint-plugin-import": {
      "minimatch": "^3.1.5"
    },
    "eslint-plugin-jsx-a11y": {
      "minimatch": "^3.1.5"
    },
    "eslint-plugin-react": {
      "minimatch": "^3.1.5"
    },
    "flat-cache": {
      "flatted": "^3.4.2"
    },
    "js-yaml": "^3.14.2",
    "mdast-util-to-hast": "^13.2.1",
    "postcss": "$postcss"
  }
}
